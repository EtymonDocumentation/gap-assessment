{
  "name": "@gap/process-model",
  "version": "1.10.0",
  "private": true,
  "description": "Shared fill/finish process model: types, schemas, units, entries, sources and the unit-operation catalog. Side-agnostic; used by the gap assessment and the later TRD and MBR tools.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog-data.ts",
      "default": "./src/catalog-data.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./catalog": {
        "types": "./dist/catalog-data.d.ts",
        "default": "./dist/catalog-data.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs && node scripts/publish-manifest.mjs apply",
    "postpack": "node scripts/publish-manifest.mjs restore"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
